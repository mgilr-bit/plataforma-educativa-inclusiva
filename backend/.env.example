# Puerto en el que escucha la API
PORT=4000

# Cadena de conexion a PostgreSQL
DATABASE_URL=postgresql://miltongil@localhost:5432/plataforma_educativa
# Poner en true solo si la base exige TLS. La conexión interna de Railway va por
# red privada y no lo ofrece, así que ahí debe quedar en false.
DATABASE_SSL=false

# Clave para firmar los JSON Web Tokens (generar una distinta en cada entorno)
JWT_SECRET=cambie-esta-clave-por-una-aleatoria-y-larga
# Vigencia del token de sesion
JWT_EXPIRES_IN=8h

# Clave de la Whisper API de OpenAI (transcripción de voz a texto).
# Sin ella, el endpoint de transcripción responde 503 y el resto de la API sigue funcionando.
OPENAI_API_KEY=
# URL base de la API; se cambia solo para apuntar a un servidor de pruebas.
OPENAI_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1

# Clave de la Claude API de Anthropic (asistente educativo).
# Sin ella, el endpoint del tutor responde 503 y el resto de la API sigue funcionando.
ANTHROPIC_API_KEY=
# URL base de la API; se cambia solo para apuntar a un servidor de pruebas.
ANTHROPIC_BASE_URL=
TUTOR_MODEL=claude-opus-5
# Nivel de esfuerzo del modelo: low, medium, high, xhigh o max.
TUTOR_EFFORT=low

# Orígenes permitidos por CORS, separados por comas (por ejemplo, la URL de
# Vercel). Si queda vacío se permite cualquiera, lo aceptable solo en local.
CORS_ORIGINS=
